{
  "name": "decky-proton-launch",
  "version": "0.16.3",
  "display_name": "Proton Launch",
  "description": "Manage Proton launch options easily on Steam",
  "type": "module",
  "scripts": {
    "version": "node -e \"const fs=require('fs');const p='./plugin.json';const o=JSON.parse(fs.readFileSync(p));o.version=process.env.npm_package_version;fs.writeFileSync(p,JSON.stringify(o,null,2)+'\\n');\" && git add plugin.json",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "fix:prettier": "prettier --config .prettierrc --write ./src",
    "fix:eslint": "eslint -c .eslintrc.cjs src --ext .ts,.tsx --fix",
    "check:prettier": "prettier ./src --check",
    "check:eslint": "eslint -c .eslintrc.cjs src --ext .ts,.tsx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteamDeckHomebrew/decky-plugin-template.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "plugin-template",
    "steam-deck",
    "deck"
  ],
  "author": "moi952",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/SteamDeckHomebrew/decky-plugin-template/issues"
  },
  "homepage": "https://github.com/SteamDeckHomebrew/decky-plugin-template#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.0",
    "@rollup/rollup-linux-x64-musl": "^4.63.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@moi952/decky-plugin-toolkit": "github:moi952/decky-plugin-toolkit#v0.1.0&path:frontend",
    "@moi952/decky-ui-kit": "^0.6.0",
    "i18next": "^25.10.10",
    "react-i18next": "^16.6.6",
    "react-icons": "^5.7.0",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
